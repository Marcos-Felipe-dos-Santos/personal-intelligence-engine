# PIE — Personal Intelligence Engine
# Copy this file to .env and adjust values as needed.
# Keep real .env files out of Git. This example contains no secrets.

# Fixed root directory for all PIE data paths.
# When set, all relative paths (database, notes, reports, backups, exports)
# resolve under this directory, regardless of the current working directory.
# Absolute individual paths always take precedence over PIE_HOME.
# PIE_HOME=

# Path to the SQLite database file (relative to PIE_HOME or project root)
PIE_DATABASE_PATH=pie.db

# Directory for generated Markdown notes
PIE_NOTES_DIR=notes

# Directory for generated reports
PIE_REPORTS_DIR=reports

# Directory for backups
# PIE_BACKUP_DIR=backups

# Directory for exports
# PIE_EXPORT_DIR=exports

# Log level: DEBUG, INFO, WARNING, ERROR
PIE_LOG_LEVEL=INFO

# Local timezone used to interpret pie report daily --date.
# Timestamps remain stored in UTC.
PIE_LOCAL_TIMEZONE=America/Sao_Paulo

# Optional extraction backend.
# fake is deterministic and remains the default. ollama is experimental and local-only.
PIE_EXTRACTOR_BACKEND=fake

# Optional Ollama settings used only when PIE_EXTRACTOR_BACKEND=ollama.
PIE_OLLAMA_BASE_URL=http://localhost:11434
PIE_OLLAMA_MODEL=
PIE_LLM_TIMEOUT_SECONDS=30
PIE_LLM_MAX_RETRIES=2
PIE_LLM_RETRY_BACKOFF_SECONDS=1

# Allow Ollama to connect to remote (non-loopback) hosts.
# WARNING: when true, raw entry text will be sent over the network to the configured host.
# Default is false — only localhost/127.0.0.1/::1 are allowed.
# PIE_ALLOW_REMOTE_OLLAMA=false
